# Google Search Console HTML verification token (the content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Approved AdSense publisher client, for example ca-pub-0000000000000000.
# Only enable this on hosting whose plan permits commercial use. Vercel Hobby does not.
# EEA/UK/Switzerland traffic also requires a Google-certified TCF CMP.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ten-digit AdSense ad unit slot ID, for example 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=

# Optional paid partner landing pages. HTTPS only. Leave blank until the
# relationship is approved and the disclosure page has been reviewed.
NEXT_PUBLIC_PARTNER_BORROWING_URL=
NEXT_PUBLIC_PARTNER_SAVING_URL=
NEXT_PUBLIC_PARTNER_INVESTING_URL=
NEXT_PUBLIC_PARTNER_PLANNING_URL=

# Public business inbox shown on the advertising page. Do not use a private
# address unless you are comfortable publishing it on the website.
NEXT_PUBLIC_BUSINESS_EMAIL=
